# FundiMtaani environment settings.
# Copy this file to .env and fill in the values. The .env file itself is
# never committed to git.

# Required. The app refuses to start without it.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Admin account created by seed.py (only used at seed time).
# Leave these commented out and seed.py uses admin@fundimtaani.co.ke /
# admin1234 as the demo admin — change them before real use.
# ADMIN_EMAIL=admin@fundimtaani.co.ke
# ADMIN_PASSWORD=admin1234

# Email (optional). If these are all set, the app sends real email with
# Python's built-in smtplib. If they are not set, the app runs in demo
# mode: emails are written to instance/dev-outbox.txt and verification /
# login codes are shown on the page in a labelled demo box.
# MAIL_SERVER=smtp.example.com
# MAIL_PORT=587
# MAIL_USERNAME=you@example.com
# MAIL_PASSWORD=your-mail-password
# MAIL_FROM=FundiMtaani <no-reply@example.com>

# Database. MySQL is the database for this project — XAMPP MySQL on the
# Mac, or any MySQL / MariaDB server. seed.py creates the database if it
# does not exist yet, so you only need the server itself running. Set the
# user, password and host to match your MySQL: on XAMPP the user is root
# with no password.
DATABASE_URL=mysql+pymysql://root:@127.0.0.1:3306/fundimtaani
# If DATABASE_URL is left unset, the app falls back to a SQLite file at
# instance/fundimtaani.db (handy for a quick test, not for the real run).

# Set to "production" on a live server (makes the session cookie HTTPS-only).
# FLASK_ENV=production
